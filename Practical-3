#include <iostream>
using namespace std;

// Function to read array elements
void readArray(int a[], int n) {
    cout << "Enter elements: ";

    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }
}

// Function to display array elements
void displayArray(const int a[], int n) {
    for (int i = 0; i < n; i++) {
        cout << a[i] << " ";
    }
    cout << endl;
}

// Function to swap two values using call by reference
void swapValues(int &x, int &y) {
    int temp = x;
    x = y;
    y = temp;
}

// Function to sort array using Bubble Sort
void sortArray(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {

        for (int j = 0; j < n - i - 1; j++) {

            if (a[j] > a[j + 1]) {
                swapValues(a[j], a[j + 1]);
            }
        }
    }
}

int main() {
    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    int a[n];

    readArray(a, n);

    cout << "Original array: ";
    displayArray(a, n);

    sortArray(a, n);

    cout << "Sorted array: ";
    displayArray(a, n);

    return 0;
}
