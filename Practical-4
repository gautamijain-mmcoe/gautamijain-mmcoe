#include <iostream>
using namespace std;

class Complex {
private:
    double real;
    double imag;

public:
    // Constructor
    Complex() {
        real = 0;
        imag = 0;
    }

    // Function to accept complex number
    void accept() {
        cout << "Enter real and imaginary parts: ";
        cin >> real >> imag;
    }

    // Function to display complex number
    void display() const {
        if (imag >= 0)
            cout << real << " + j" << imag << endl;
        else
            cout << real << " - j" << -imag << endl;
    }

    // Addition
    Complex add(Complex c) {
        Complex result;
        result.real = real + c.real;
        result.imag = imag + c.imag;
        return result;
    }

    // Subtraction
    Complex subtract(Complex c) {
        Complex result;
        result.real = real - c.real;
        result.imag = imag - c.imag;
        return result;
    }

    // Multiplication
    Complex multiply(Complex c) {
        Complex result;
        result.real = (real * c.real) - (imag * c.imag);
        result.imag = (real * c.imag) + (imag * c.real);
        return result;
    }

    // Division
    Complex divide(Complex c) {
        Complex result;

        double denominator = (c.real * c.real) + (c.imag * c.imag);

        if (denominator == 0) {
            cout << "Division by zero is not possible." << endl;
            return result;
        }

        result.real = ((real * c.real) + (imag * c.imag)) / denominator;
        result.imag = ((imag * c.real) - (real * c.imag)) / denominator;

        return result;
    }

    // Complex conjugate
    Complex conjugate() {
        Complex result;
        result.real = real;
        result.imag = -imag;
        return result;
    }
};

int main() {
    Complex c1, c2;
    Complex result;

    cout << "Complex number 1" << endl;
    c1.accept();

    cout << "Complex number 2" << endl;
    c2.accept();

    result = c1.add(c2);
    cout << "Addition: ";
    result.display();

    result = c1.subtract(c2);
    cout << "Subtraction: ";
    result.display();

    result = c1.multiply(c2);
    cout << "Multiplication: ";
    result.display();

    result = c1.divide(c2);
    cout << "Division: ";
    result.display();

    result = c1.conjugate();
    cout << "Conjugate of first number: ";
    result.display();

    return 0;
}
