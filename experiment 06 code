#include <iostream>                    // Includes input and output functions
using namespace std;                   // Allows use of cin and cout directly

class Complex                          // Defines a class named Complex
{
private:
    int real;                           // Stores the real part
    int imag;                           // Stores the imaginary part

public:

    // Function to accept a complex number
    void accept()
    {
        cout << "Enter real part: ";    // Asks the user for real part
        cin >> real;                   // Takes real part as input

        cout << "Enter imaginary part: "; // Asks for imaginary part
        cin >> imag;                   // Takes imaginary part as input
    }

    // Overloads the * operator
    Complex operator*(Complex c)
    {
        Complex result;                // Creates an object to store the result

        result.real = (real * c.real) - (imag * c.imag);
        // Calculates the real part of multiplication

        result.imag = (real * c.imag) + (imag * c.real);
        // Calculates the imaginary part of multiplication

        return result;                 // Returns the resulting complex number
    }

    // Function to display a complex number
    void display()
    {
        if (imag >= 0)                  // Checks if imaginary part is positive
        {
            cout << real << " + j" << imag; // Displays positive imaginary part
        }
        else
        {
            cout << real << " - j" << -imag; // Displays negative imaginary part
        }
    }
};

int main()                              // Main function
{
    Complex c1, c2, result;             // Creates three Complex objects

    cout << "Enter first complex number:" << endl;
    c1.accept();                        // Accepts first complex number

    cout << "\nEnter second complex number:" << endl;
    c2.accept();                        // Accepts second complex number

    result = c1 * c2;                   // Calls overloaded * operator

    cout << "\nMultiplication = ";      // Displays result message
    result.display();                   // Displays the multiplication result

    return 0;                           // Ends the program
}
