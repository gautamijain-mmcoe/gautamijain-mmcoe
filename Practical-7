#include <iostream>
#include <cstring>
using namespace std;

class MyString {
private:
    char *data;

public:
    // Default constructor
    MyString() {
        data = new char[1];
        data[0] = '\0';
    }

    // Parameterized constructor
    MyString(const char *str) {
        data = new char[strlen(str) + 1];
        strcpy(data, str);
    }

    // Copy constructor - Deep Copy
    MyString(const MyString &s) {
        data = new char[strlen(s.data) + 1];
        strcpy(data, s.data);
    }

    // Destructor
    ~MyString() {
        delete[] data;
    }

    // Accept function
    void accept() {
        char temp[200];

        cout << "Enter a string: ";
        cin.getline(temp, 200);

        delete[] data;

        data = new char[strlen(temp) + 1];
        strcpy(data, temp);
    }

    // Display function
    void display() const {
        cout << data;
    }
};

int main() {

    // Default constructor
    MyString s1;

    // Accept string from user
    s1.accept();

    // Parameterized constructor
    MyString s2("Object Oriented Programming");

    // Copy constructor
    MyString s3(s2);

    cout << "s1 = ";
    s1.display();
    cout << endl;

    cout << "s2 = ";
    s2.display();
    cout << endl;

    cout << "s3 (copy of s2) = ";
    s3.display();
    cout << endl;

    return 0;
}
